{
  "name": "music-app-react-lite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm:dev:web:wait\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:web:wait": "wait-on http-get://127.0.0.1:8787/api/health && npm run dev:web",
    "dev:api": "wrangler dev --port 8787",
    "d1:local": "wrangler d1 migrations apply music-app-db --local",
    "d1:remote": "wrangler d1 migrations apply music-app-db --remote",
    "build": "tsc && vite build && tsc -p tsconfig.worker.json",
    "preview": "vite preview",
    "deploy": "npm run build && npm run d1:remote && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "wait-on": "^8.0.5",
    "wrangler": "^4.148.0"
  }
}
